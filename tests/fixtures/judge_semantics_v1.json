{
  "dataset_id": "creatoros.judge-semantics.v1",
  "frozen_on": "2026-10-23",
  "description": "固定边界题，不是创作质量榜单；参考均为题内文字，没有图片、完整剧本或数据库。",
  "cases": [
    {
      "id": "R01",
      "name": "整体 Skill：混合操作与作品要求",
      "kind": "rubric",
      "payload": {
        "instructions": "只创建候选，最多3轮，不自动发布，不切换栏目，不覆盖共享Skill。作品固定2×2四格，4个常用英语词；简短情境体现词义差别；文字清楚，不遮住人物的脸。优秀参考文字：look是主动看，see是看见，watch是持续观看，stare是盯着看；每格一句具体日常例句、词和中文释义，统一白底深色字。没有提供任何候选产物。",
        "topic": "look / see / watch / stare",
        "topic_brief": "用四种日常情境区分四个词。",
        "role": "legacy_end_to_end",
        "judge_policy": {"version": 2, "scope": "overall", "role": "legacy_end_to_end"}
      },
      "expected": {
        "domains": ["content", "presentation"],
        "required_quality_groups": [
          {"label": "词义与情境", "any_of": ["词义", "语义", "情境", "例句"]},
          {"label": "四格版式", "any_of": ["四格", "2×2", "2x2", "2*2"]},
          {"label": "文字可读", "any_of": ["清楚", "清晰", "可读", "易读"]}
        ],
        "required_workflow_groups": [
          {"label": "轮数", "any_of": ["3轮", "三轮"]},
          {"label": "发布限制", "any_of": ["不自动发布", "不发布", "不得发布"]},
          {"label": "栏目保护", "any_of": ["不切换栏目", "不切栏目", "不改变栏目"]},
          {"label": "共享保护", "any_of": ["不覆盖共享", "不得覆盖共享", "不修改共享"]}
        ],
        "forbidden_quality_terms": ["轮数", "3轮", "三轮", "不发布", "自动发布", "发布权限", "是否发布", "发布状态", "发布操作", "切换栏目", "切栏目", "共享Skill", "共享 Skill", "队列", "线程"]
      }
    },
    {
      "id": "R02",
      "name": "Mind：只评故事文案，不按画风扣分",
      "kind": "rubric",
      "payload": {
        "instructions": "只校准Mind。优秀参考文字：柯基对失意的朋友说‘一次没成不代表你不行’，深夜却因自己的画只有三个赞认定自己没用。标准是同一个角色的自我矛盾、具体生活细节、前后情节承接和自然白话文案。不要空泛口号，不照搬参考人物。最多2轮，不发布。未提供候选产物。",
        "topic": "会安慰别人，却不肯原谅自己",
        "topic_brief": "换一个生活事件，保留自我对照的叙事结构。",
        "role": "mind",
        "judge_policy": {"version": 2, "scope": "content", "role": "mind"}
      },
      "expected": {
        "domains": ["content"],
        "required_quality_groups": [
          {"label": "自我矛盾", "any_of": ["矛盾", "对照", "反差", "双重标准"]},
          {"label": "具体细节", "any_of": ["具体", "生活细节", "生活事件"]},
          {"label": "情节承接", "any_of": ["承接", "因果", "前后", "关联"]}
        ],
        "required_workflow_groups": [{"label": "轮数", "any_of": ["2轮", "两轮"]}],
        "forbidden_quality_terms": ["不发布", "自动发布", "发布权限", "2轮", "两轮", "色温", "字号", "画风", "分辨率", "光比", "版式"]
      }
    },
    {
