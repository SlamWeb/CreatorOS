      "expected": {
        "domains": ["presentation"],
        "required_quality_groups": [
          {"label": "两格布局", "any_of": ["两格", "上下格", "上下两", "双格"]},
          {"label": "体素风格", "any_of": ["体素", "方块"]},
          {"label": "视觉对比", "any_of": ["机位", "视角", "冷暖", "光线", "色温"]}
        ],
        "required_workflow_groups": [{"label": "轮数", "any_of": ["3轮", "三轮"]}],
        "forbidden_quality_terms": ["3轮", "三轮", "预算", "切栏目", "故事立意", "教育意义", "剧情深刻", "情节因果"]
      }
    },
    {
      "id": "R04",
      "name": "合法创作禁令：不能把所有‘不’都当操作",
      "kind": "rubric",
      "payload": {
        "instructions": "优秀参考文字：一张简洁的单页词汇漫画，每个词有准确释义和具体短句，视觉留白克制。作品不得添加全图标题，不要密集噪点，不允许图案遮挡文字。这三项是作品质量要求，须进入可检查标准。最多2轮，排队等待由宿主管理，不发布、不切栏目。还没有候选产物。",
        "topic": "四个日常词汇",
        "topic_brief": "保持词义准确和阅读清晰。",
        "role": "legacy_end_to_end",
        "judge_policy": {"version": 2, "scope": "overall", "role": "legacy_end_to_end"}
      },
      "expected": {
        "domains": ["content", "presentation"],
        "required_quality_groups": [
          {"label": "无额外标题", "any_of": ["标题"]},
          {"label": "无噪点", "any_of": ["噪点", "噪声"]},
          {"label": "文字不被遮挡", "any_of": ["遮挡", "遮住", "遮蔽", "覆盖文字"]}
        ],
        "required_workflow_groups": [{"label": "轮数", "any_of": ["2轮", "两轮"]}],
        "forbidden_quality_terms": ["2轮", "两轮", "排队", "不发布", "自动发布", "发布权限", "切栏目"]
      }
    },
    {
      "id": "R05",
      "name": "建标阶段：不能声称收到产物或完整剧本",
      "kind": "rubric",
      "payload": {
        "instructions": "本次只有优秀参考文字：一则故事先写具体行动，再交代相反结果，结尾留出角色自己的反应；文案用自然白话，事实前后一致。依据这些参考建立Mind标准。没有候选、没有图片、没有发布正文、没有完整剧本。别把未来需要检查的材料说成已经收到。只建候选，不发布。",
        "topic": "一次没有被看见的努力",
        "topic_brief": "测试新的生活事件。",
        "role": "mind",
        "judge_policy": {"version": 2, "scope": "content", "role": "mind"}
      },
      "expected": {
        "domains": ["content"],
        "required_quality_groups": [
          {"label": "行动与结果", "any_of": ["行动", "动作", "结果"]},
          {"label": "自然文案", "any_of": ["白话", "自然", "口语"]},
          {"label": "事实一致", "any_of": ["一致", "前后", "矛盾"]}
        ],
        "required_workflow_groups": [],
        "forbidden_quality_terms": ["不发布", "自动发布", "发布权限", "候选版本保存", "线程"],
        "forbid_received_claims": true
      }
    },
